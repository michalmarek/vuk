---
layout: base.njk
translationKey: vyrobky
activeNav: vyrobky
title: "Produkte"
description: "Sechs Bereiche der Keramikfertigung auf Bestellung: historische Fliesen, Verkleidungen, Außen- und Technische Keramik, Spezialanfertigung und Kacheln."
---
{%- set t = i18n[lang] %}
<section class="produce produce--page">
  <div class="container">
    <div class="produce__head">
      <div>
        <p class="eyebrow">{{ t.coVyrabimeNadtitulek }}</p>
        <h1 class="section-title">{{ t.nav.vyrobky }}</h1>
      </div>
      <p class="produce__perex">{{ t.coVyrabimePerex }}</p>
    </div>
    <div class="card-grid">
      {%- for p in collections.vyrobek | byLang(lang) %}
      <a href="{{ p.url }}" class="card">
        <div class="card__media">
          {% obrazek p.data.img, p.data.name, "", "(max-width: 700px) 50vw, 25vw", "karta" %}
          <span class="card__icon">{% include "icons/" + p.data.icon + "-ui.svg" %}</span>
        </div>
        <div class="card__body">
          <div class="card__head">
            <span class="card__name">{{ p.data.name }}</span>
            <span class="card__arrow" aria-hidden="true">→</span>
          </div>
          <p class="card__line">{{ p.data.line }}</p>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
