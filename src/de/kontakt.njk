---
layout: base.njk
translationKey: kontakt
activeNav: kontakt
submenuCompact: true
title: "Kontakt"
perex: "Rufen Sie an oder schreiben Sie uns mit einer Beschreibung Ihres Projekts. Wir kommen gern vorbei und sehen uns die Keramik an, die ersetzt oder ergänzt werden soll."
---
{%- set t = i18n[lang] %}
<div class="submenu-sentinel" aria-hidden="true"></div>
{% include "partials/submenu-vyrobky.njk" %}

<section class="page-head"><div class="container">
  <h1 class="section-title">{{ title }}</h1>
  <p class="page-head__perex">{{ perex }}</p>
</div></section>

<section class="kontakt"><div class="container">
  <div class="kontakt__col">
    <h2>Wo Sie uns finden</h2>
    <span class="kontakt__line"><strong>{{ site.nazev }}</strong></span>
    <span class="kontakt__line">{{ site.adresa.ulice }}</span>
    <span class="kontakt__line">{{ site.adresa.mesto }}</span>
    <span class="kontakt__line">IČO: {{ site.ico }}</span>
    <a class="kontakt__maplink" href="{{ site.mapaUrl }}" target="_blank" rel="noopener">Auf der Karte anzeigen →</a>
  </div>
  <div class="kontakt__col">
    <h2>Kontaktieren Sie uns</h2>
    <span class="kontakt__line">Telefon</span>
    <a class="kontakt__big" href="tel:{{ site.telefonRaw }}">{{ site.telefon }}</a>
    <span class="kontakt__line" style="margin-top:14px">E-Mail</span>
    <a class="kontakt__big" href="mailto:{{ site.email }}">{{ site.email }}</a>
    <div class="kontakt__osoba">
      <span class="kontakt__line"><strong>Ansprechpartnerin</strong></span>
      <span class="kontakt__line">{{ site.kontaktOsoba.jmeno }}</span>
      <a class="kontakt__big" href="tel:{{ site.kontaktOsoba.telefonRaw }}">{{ site.kontaktOsoba.telefon }}</a>
    </div>
  </div>
</div></section>
