---
layout: base.njk
activeNav: vyrobky
---
{%- set t = i18n[lang] %}
{%- set activeVyrobek = translationKey %}
{%- set vyrobkyHref = "/vyrobky/" if lang == "cs" else "/" + lang + "/produkte/" %}
{%- set faqHref = "/caste-dotazy/" if lang == "cs" else "/" + lang + "/haeufige-fragen/" %}
{%- set galerie = reference | proVyrobek(translationKey) %}
{%- set faqItems = faq[lang] | faqProVyrobek(translationKey) | limit(5) %}
<div class="submenu-sentinel" aria-hidden="true"></div>
{% include "partials/submenu-vyrobky.njk" %}

{# ---------- Hero (fullbleed) ---------- #}
<section class="phero" style="background-image:linear-gradient(rgba(46,42,44,.45),rgba(46,42,44,.55)),url('{{ heroFoto or img }}')">
  <div class="container phero__inner">
    <p class="phero__crumb"><a href="{{ vyrobkyHref }}">{{ t.nav.vyrobky }}</a> / {{ name }}</p>
    <div class="phero__body">
      <h1 class="phero__title">{{ name }}</h1>
      {%- if podtitulek %}<p class="phero__subtitle">{{ podtitulek }}</p>{%- endif %}
      <div class="btn-row">
        <a href="tel:{{ site.telefonRaw }}" class="btn btn--primary">{{ t.zavolejte }} {{ site.telefon }}</a>
        <a href="mailto:{{ site.email }}" class="btn btn--ghost btn--ghost-light">{{ t.napisteNam }}</a>
      </div>
    </div>
  </div>
</section>

{# ---------- Úvodní odstavec ---------- #}
{%- if content %}
<section class="pintro"><div class="container"><div class="prose">{{ content | safe }}</div></div></section>
{%- endif %}

{# ---------- Tři bloky ---------- #}
{%- if bloky %}
<section class="pbloky"><div class="container">
  {%- for b in bloky %}
  <div class="pblok"><h3>{{ b.nadpis }}</h3><p>{{ b.text }}</p></div>
  {%- endfor %}
</div></section>
{%- endif %}

{# ---------- Nabídka zahrnuje ---------- #}
{%- if nabidka %}
<section class="pnabidka{{ ' pnabidka--foto' if nabidka.foto }}"><div class="container">
  {%- if nabidka.foto %}
  <div class="pnabidka__fotky">
    {%- for f in nabidka.foto %}<img src="{{ f }}" alt="" loading="lazy" class="pnabidka__foto">{%- endfor %}
  </div>
  {%- endif %}
  <div class="pnabidka__text">
    <h2>{{ nabidka.nadpis }}</h2>
    <ul class="pnabidka__list">
      {%- for item in nabidka.polozky %}<li>{{ item }}</li>{%- endfor %}
    </ul>
    {%- if nabidka.poznamka %}<p class="pnabidka__note">{{ nabidka.poznamka }}</p>{%- endif %}
  </div>
</div></section>
{%- endif %}

{# ---------- Postup výroby (volitelné) ---------- #}
{%- if postup %}{% include "partials/postup.njk" %}{%- endif %}

{# ---------- Ukázky realizací ---------- #}
{%- if galerie.length %}
<section class="pgalerie"><div class="container">
  <h2 class="pgalerie__nadpis">{{ t.ukazkyRealizaci }}</h2>
  <div class="pgalerie__grid">
    {%- set otevrit = t.otevritGalerii or "Otevřít galerii" %}
    {%- for r in galerie %}
    {% dlazdiceRealizace r, otevrit %}
    {%- endfor %}
  </div>
  {# Postupné odkrývání – tlačítko se zobrazí jen s JS; bez JS jsou vidět všechny realizace #}
  {%- if galerie.length > 8 %}
  <div class="pgalerie__viac">
    <button type="button" class="btn btn--ghost pgalerie__viac-btn" hidden>{{ t.zobrazitDalsi or "Zobrazit další realizace" }}</button>
  </div>
  {%- endif %}
</div></section>

{# Lightbox – velké foto + náhledy ostatních; ovládá se přes data-fota na dlaždici #}
<dialog class="lightbox" id="lightbox" aria-label="Galerie realizace">
  <button type="button" class="lightbox__close" data-lb-close aria-label="Zavřít">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 5 19 19M19 5 5 19"/></svg>
  </button>
  <figure class="lightbox__stage">
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Předchozí">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M15 4 7 12l8 8"/></svg>
    </button>
    <img class="lightbox__img" alt="">
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Další">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M9 4 17 12l-8 8"/></svg>
    </button>
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
  <div class="lightbox__thumbs" role="tablist"></div>
</dialog>
<script>
(() => {
  // Postupné odkrývání realizací po dávkách (8 = dva řádky)
  const grid = document.querySelector(".pgalerie__grid");
  const viacBtn = document.querySelector(".pgalerie__viac-btn");
  if (grid && viacBtn) {
    const items = [...grid.children];
    const DAVKA = 8;
    let zobrazeno = DAVKA;
    if (items.length > DAVKA) {
      const update = () => {
        items.forEach((it, idx) => { it.hidden = idx >= zobrazeno; });
        viacBtn.hidden = zobrazeno >= items.length;
      };
      viacBtn.addEventListener("click", () => { zobrazeno += DAVKA; update(); });
      update();
    }
  }

  const dlg = document.getElementById("lightbox");
  if (!dlg || !dlg.showModal) return;
  const img = dlg.querySelector(".lightbox__img");
  const cap = dlg.querySelector(".lightbox__caption");
  const thumbs = dlg.querySelector(".lightbox__thumbs");
  const prevBtn = dlg.querySelector("[data-lb-prev]");
  const nextBtn = dlg.querySelector("[data-lb-next]");
  let fota = [], i = 0;

  const show = (n) => {
    i = (n + fota.length) % fota.length;
    img.src = fota[i];
    [...thumbs.children].forEach((b, k) => b.setAttribute("aria-selected", k === i));
  };
  const open = (item, start) => {
    try { fota = JSON.parse(item.dataset.fota); } catch { return; }
    cap.textContent = item.dataset.popis || "";
    img.alt = item.dataset.popis || "";
    thumbs.innerHTML = "";
    thumbs.hidden = fota.length < 2;
    prevBtn.hidden = nextBtn.hidden = fota.length < 2;
    fota.forEach((src, k) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "lightbox__thumb";
      b.innerHTML = '<img src="' + src + '" alt="" loading="lazy">';
      b.addEventListener("click", () => show(k));
      thumbs.appendChild(b);
    });
    show(start || 0);
    dlg.showModal();
  };

  document.querySelectorAll(".pgalerie__item[data-fota]").forEach((item) =>
    item.querySelectorAll("[data-lb]").forEach((el) =>
      el.addEventListener("click", () => open(item, +el.dataset.lb))
    )
  );
  dlg.querySelector("[data-lb-prev]").addEventListener("click", () => show(i - 1));
  dlg.querySelector("[data-lb-next]").addEventListener("click", () => show(i + 1));
  dlg.querySelector("[data-lb-close]").addEventListener("click", () => dlg.close());
  dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
  document.addEventListener("keydown", (e) => {
    if (!dlg.open) return;
    if (e.key === "ArrowLeft") show(i - 1);
    if (e.key === "ArrowRight") show(i + 1);
  });
})();
</script>
{%- endif %}

{# ---------- FAQ + kontaktní box ---------- #}
{%- if faqItems.length %}
<section class="pfaq"><div class="container">
  <div class="pfaq__list">
    <h2>{{ t.casteDotazyNadpis }}</h2>
    {%- for q in faqItems %}
    <details class="faq-item">
      <summary>{{ q.otazka }}<span class="faq-item__mark" aria-hidden="true">+</span></summary>
      <div class="faq-item__body"><p>{{ q.odpoved }}</p></div>
    </details>
    {%- endfor %}
    <a href="{{ faqHref }}" class="inline-link pfaq__all">{{ t.vsechnyDotazy }}</a>
  </div>
  <aside class="pkontakt">
    <h3>{{ t.ctaNadpis }}</h3>
    <p>{{ t.kontaktBoxText }}</p>
    <div class="pkontakt__osoba">
      <span class="pkontakt__jmeno">{{ site.kontaktOsoba.jmeno }}</span>
      <a href="tel:{{ site.telefonRaw }}" class="pkontakt__tel">{{ site.telefon }}</a>
      <a href="mailto:{{ site.email }}" class="pkontakt__mail">{{ site.email }}</a>
    </div>
  </aside>
</div></section>
{%- endif %}

{# ---------- Další výrobky ---------- #}
<section class="pdalsi"><div class="container">
  <h2>{{ t.dalsiVyrobky }}</h2>
  <div class="pdalsi__grid">
    {%- for p in collections.vyrobek | byLang(lang) %}
    {%- if p.data.translationKey != translationKey %}
    <a href="{{ p.url }}" class="pdalsi__item">
      <img src="{{ p.data.img }}" alt="{{ p.data.name }}" loading="lazy">
      <span>{{ p.data.name }}</span>
    </a>
    {%- endif %}
    {%- endfor %}
  </div>
</div></section>
