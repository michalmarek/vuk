{#- Pás fotek přes tři sloupce. Očekává: fotky = [{ src, alt }] -#}
<section class="foto-pas"><div class="container">
  <div class="foto-pas__grid">
    {%- for f in fotky %}
    {% obrazek f.src, f.alt, "foto-pas__img", "(max-width: 700px) 100vw, 33vw", "karta" %}
    {%- endfor %}
  </div>
</div></section>
