---
layout: base.njk
---
{%- set t = i18n[lang] %}

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{{ heroNadtitulek }}</p>
      <h1 class="hero__title">{{ heroH1 }}</h1>
      <p class="hero__perex">{{ heroPerex }}</p>
      <div class="btn-row">
        <a href="tel:{{ site.telefonRaw }}" class="btn btn--primary">{{ t.zavolejte }} {{ site.telefon }}</a>
        <a href="mailto:{{ site.email }}" class="btn btn--ghost">{{ t.napisteNam }}</a>
      </div>
    </div>
    <img class="hero__img" src="{{ heroImg }}" alt="{{ heroImgAlt }}">
  </div>
</section>

<section class="produce">
  <div class="container">
    <div class="produce__head">
      <div>
        <p class="eyebrow">{{ t.coVyrabimeNadtitulek }}</p>
        <h2 class="section-title">{{ t.coVyrabime }}</h2>
      </div>
      <p class="produce__perex">{{ t.coVyrabimePerex }}</p>
    </div>
    <div class="card-grid">
      {%- for p in collections.vyrobek | byLang(lang) %}
      {% include "partials/card-vyrobek.njk" %}
      {%- endfor %}
    </div>
  </div>
</section>

<section class="facts">
  <div class="container facts__grid">
    {%- for f in t.fakta %}
    <div class="fact">
      <span class="fact__big">{{ f.big }}</span>
      <span class="fact__small">{{ f.small }}</span>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2 class="cta__title">{{ t.ctaNadpis }}</h2>
      <p class="cta__perex">{{ t.ctaPerex }}</p>
      <div class="cta__contacts">
        <a href="tel:{{ site.telefonRaw }}">{{ site.telefon }}</a>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
    </div>
    <address class="cta__address">
      <strong>{{ site.nazev }}</strong>
      <span>{{ site.adresa.ulice }}</span>
      <span>{{ site.adresa.mesto }}</span>
      <span class="cta__ico">IČO: {{ site.ico }}</span>
    </address>
  </div>
</section>
