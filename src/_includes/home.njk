---
layout: base.njk
---
{%- set t = i18n[lang] %}
{%- set jakHref = "/jak-objednat/" if lang == "cs" else "/" + lang + "/so-bestellen/" %}
{%- set oNasHref = "/o-nas/" if lang == "cs" else "/" + lang + "/ueber-uns/" %}

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{{ heroNadtitulek }}</p>
      <h1 class="hero__title">{{ heroH1 }}</h1>
      <p class="hero__perex">{{ heroPerex }}</p>
      <div class="btn-row">
        <a href="tel:{{ site.telefonRaw }}" class="btn btn--primary">{{ t.zavolejte }} {{ site.telefon }}</a>
        <a href="mailto:{{ site.email }}" class="btn btn--ghost">{{ t.napisteNam }}</a>
      </div>
    </div>
    {% obrazek heroImg, heroImgAlt, "hero__img", "(max-width: 700px) 100vw, 50vw", "hero" %}
  </div>
</section>

<section class="produce">
  <div class="container">
    <div class="produce__head">
      <div>
        <p class="eyebrow">{{ t.coVyrabimeNadtitulek }}</p>
        <h2 class="section-title">{{ t.coVyrabime }}</h2>
      </div>
      <p class="produce__perex">{{ t.coVyrabimePerex }}</p>
    </div>
    <div class="card-grid">
      {%- for p in collections.vyrobek | byLang(lang) %}
      <a href="{{ p.url }}" class="card">
        <div class="card__media">
          {% obrazek p.data.img, p.data.name, "", "(max-width: 700px) 50vw, 25vw", "karta" %}
          <span class="card__icon">{% include "icons/" + p.data.icon + "-ui.svg" %}</span>
        </div>
        <div class="card__body">
          <div class="card__head">
            <span class="card__name">{{ p.data.name }}</span>
            <span class="card__arrow" aria-hidden="true">→</span>
          </div>
          <p class="card__line">{{ p.data.line }}</p>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="facts">
  <div class="container facts__grid">
    {%- for f in t.fakta %}
    <div class="fact">
      <span class="fact__big">{{ f.big }}</span>
      <span class="fact__small">{{ f.small }}</span>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="order">
  <div class="container">
    <div class="order__intro">
      <h2>{{ jakNadpis }}</h2>
      <p>{{ jakPerex }}</p>
      {% obrazek jakFoto, jakFotoAlt, "order__photo", "(max-width: 700px) 100vw, 50vw", "obsah" %}
    </div>
    <div class="order__steps">
      {%- for k in t.kroky %}
      <div class="step">
        <span class="step__n">{{ k.cislo }}</span>
        <div>
          <span class="step__t">{{ k.nazev }}</span>
          <span class="step__d">{{ k.popis }}</span>
        </div>
      </div>
      {%- endfor %}
      <a href="{{ jakHref }}" class="inline-link">{{ t.celyPostup }}</a>
    </div>
  </div>
</section>

<section class="refs">
  {%- set hpRefs = reference | naHp %}
  <div class="container">
    <div class="refs__intro">
      <h2>{{ refNadpis }}</h2>
      <p>{{ refPerex }}</p>
      <div class="refs__list">
        {%- for r in hpRefs %}
        <div class="ref-row">
          <span class="ref-row__name">{{ r.nazev }}, {{ r.mesto }}</span>
          <span class="ref-row__what">{{ t.typy[r.typ] }}</span>
        </div>
        {%- endfor %}
      </div>
    </div>
    <div class="refs__mosaic">
      {%- for r in hpRefs | limit(3) %}
      {% realizaceFoto r, ("wide" if loop.first else "sq") %}
      {%- endfor %}
    </div>
  </div>
</section>

<section class="about">
  <div class="container">
    {% obrazek oNasFoto, oNasFotoAlt, "about__photo", "(max-width: 700px) 100vw, 50vw", "obsah" %}
    <div class="about__text">
      <h2>{{ oNasNadpis }}</h2>
      <p>{{ oNasP1 }}</p>
      <p>{{ oNasP2 }}</p>
      <a href="{{ oNasHref }}" class="inline-link">{{ t.viceODilne }}</a>
    </div>
  </div>
</section>

{% include "partials/cta.njk" %}
